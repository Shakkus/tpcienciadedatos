# Copiar a .env y completar ahi las claves. No commitear .env.
# Hosts, puertos y usuarios coinciden con docker-compose.yml.

# MinIO / S3 local (lakehouse)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nexo
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# MySQL (Sqoop / Spark JDBC)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=crm
MYSQL_USER=root
MYSQL_PASSWORD=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27018

# Neo4j (levantar aparte si RAM justa)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Cassandra (levantar aparte)
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042

# Databricks / APIs (opcional; completar si usan CE)
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
